<?xml version="1.0" encoding="UTF-8"?>
<!--
  DGR Office test suite.
  Unit tests need no database. Feature/integration tests use the `tests`
  database group (database.tests.* in .env) — a disposable MySQL 8 database
  that is migrated and seeded automatically. NEVER point it at production.
  Run: vendor/bin/phpunit            (all)
       vendor/bin/phpunit (testsuite: unit or feature)
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/codeigniter4/framework/system/Test/bootstrap.php"
    backupGlobals="false"
    colors="true"
    columns="max"
    failOnRisky="true"
    failOnWarning="true"
    cacheDirectory="writable/tmp/.phpunit.cache"
    displayDetailsOnTestsThatTriggerWarnings="true"
>
    <testsuites>
        <testsuite name="unit">
            <directory>./tests/unit</directory>
        </testsuite>
        <testsuite name="feature">
            <directory>./tests/feature</directory>
        </testsuite>
    </testsuites>

    <logging>
        <testdoxText outputFile="writable/tmp/testdox.txt"/>
        <junit outputFile="writable/tmp/junit.xml"/>
    </logging>

    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
        <exclude>
            <directory suffix=".php">./app/Views</directory>
        </exclude>
    </source>

    <php>
        <server name="app.baseURL" value="http://localhost:8080/"/>
        <server name="CODEIGNITER_SCREAM_DEPRECATIONS" value="0"/>
        <const name="HOMEPATH" value="./"/>
        <const name="CONFIGPATH" value="./app/Config/"/>
        <const name="PUBLICPATH" value="./public/"/>
    </php>
</phpunit>
