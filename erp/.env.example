#--------------------------------------------------------------------
# DGR Office — environment configuration
# Copy to `.env` (same folder as `spark`) and fill in real values.
# NEVER commit `.env`. Never put real secrets in this example file.
#--------------------------------------------------------------------

# development | production
CI_ENVIRONMENT = production

# Full public URL of the /public folder, with trailing slash
app.baseURL = 'https://office.example.com/'
app.appTimezone = 'Asia/Kolkata'
# Set true once SSL is active (redirects all HTTP to HTTPS, secure cookies)
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE (MySQL 8+, InnoDB, utf8mb4)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = dgr_office
database.default.username = dgr_office_user
database.default.password = CHANGE_ME
database.default.DBDriver = App\Database\MySQLi
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.port = 3306

# Automated tests only (separate, disposable database)
# database.tests.hostname = localhost
# database.tests.database = dgr_office_test
# database.tests.username = dgr_office_user
# database.tests.password = CHANGE_ME
# database.tests.DBDriver = App\Database\MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# ENCRYPTION — REQUIRED. Encrypts bank account numbers, CIF and
# integration secrets. Generate once with:  php spark key:generate
# Losing/changing this key makes encrypted values unreadable — back it up
# separately from the database.
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# SESSIONS / COOKIES
#--------------------------------------------------------------------
session.expiration = 7200
cookie.secure = false
cookie.httponly = true
cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# AUTH OPTIONS (all off by default)
#--------------------------------------------------------------------
# Email one-time code at login (requires SMTP below)
auth.email2fa = false
# "Keep me signed in" checkbox (7 days)
auth.allowRemembering = false
# Email sign-in link for forgotten passwords (requires SMTP)
auth.allowMagicLinkLogins = false

#--------------------------------------------------------------------
# SMTP (optional) — reminders/2FA/magic links are only emailed when set
#--------------------------------------------------------------------
email.fromEmail = ''
email.fromName = 'DGR Office'
email.protocol = 'smtp'
email.SMTPHost = ''
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 587
email.SMTPCrypto = 'tls'
email.mailType = 'html'

#--------------------------------------------------------------------
# GOOGLE SHEETS (optional) — service-account JSON key file stored
# OUTSIDE the web root, e.g. writable/credentials/sheets.service-account.json
# (chmod 600). Spreadsheet ID and tab mapping are set in the UI.
#--------------------------------------------------------------------
google.credentialsPath = ''

#--------------------------------------------------------------------
# AI PROVIDER (optional, decision-support only) — see docs/06-AI-BOUNDARY.md
# Without a key the app uses its rules-based keyword check and shows
# "Analysis unavailable" instead of any AI score. Even with a key nothing
# is sent until an owner enables the capability in Admin → AI permissions.
# The API key is read from this file only (never stored in the database,
# never shown in the UI). Model/timeout/effort can be changed in the UI.
#--------------------------------------------------------------------
ai.provider = 'anthropic'
ai.apiKey = ''
# default: claude-opus-5-5
ai.model = ''
# leave empty for the provider's default endpoint
ai.baseUrl = ''
ai.timeoutSeconds = 90
ai.maxRetries = 2
# low | medium | high
ai.effort = 'medium'
