// =============================================================================
// POLYFIX MATTRESS — PostgreSQL schema (Prisma)
// -----------------------------------------------------------------------------
// This file is a *description* of a plain PostgreSQL database. Every migration
// it produces is checked-in SQL under prisma/migrations/. POLYFIX can drop
// Prisma entirely and keep using psql, pg_dump, pgAdmin, DBeaver, Metabase or
// any other standard PostgreSQL tool against the same database.
//
// Conventions
//   * tables + columns are snake_case (@map / @@map)
//   * money   -> Decimal(12,2)
//   * ids     -> uuid v4 generated by the database (gen_random_uuid)
//   * audit   -> created_at / updated_at everywhere, created_by / updated_by on
//                records a human can change
//   * delete  -> soft delete (deleted_at + deleted_by + delete_reason) on every
//                record with legal, financial or warranty significance
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations and introspection connect as the schema owner, never as the
  // pooled least-privilege application user.
  directUrl = env("DIRECT_DATABASE_URL")
  // Only used by `prisma migrate dev` on a developer machine. Production
  // deploys run `prisma migrate deploy`, which needs no shadow database and
  // no CREATEDB privilege.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("user_status")
}

enum RoleKey {
  SUPER_ADMIN
  ADMIN
  WAREHOUSE
  WARRANTY_MANAGER
  SALES_MANAGER
  DEALER
  REPORTING

  @@map("role_key")
}

enum DealerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED

  @@map("dealer_status")
}

enum MattressStatus {
  MANUFACTURED
  IN_DISPATCH
  DISPATCHED
  DEALER_RECEIVED
  SOLD
  CLAIM_OPEN
  REPLACED
  RETURNED
  SCRAPPED

  @@map("mattress_status")
}

enum DispatchStatus {
  DRAFT
  DISPATCHED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@map("dispatch_status")
}

enum ReceiptCondition {
  OK
  DAMAGED
  MISSING

  @@map("receipt_condition")
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOID
  SUPERSEDED

  @@map("warranty_status")
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  INFO_REQUESTED
  APPROVED
  REJECTED
  REPLACED
  CLOSED
  WITHDRAWN

  @@map("claim_status")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH

  @@map("risk_level")
}

enum ClaimIssueCategory {
  SAGGING
  FABRIC_TEAR
  FOAM_DEGRADATION
  SPRING_FAILURE
  STITCHING
  SIZE_MISMATCH
  TRANSIT_DAMAGE
  OTHER

  @@map("claim_issue_category")
}

enum MediaKind {
  CLAIM_PHOTO
  CLAIM_INVOICE
  PRODUCT_IMAGE
  OG_IMAGE

  @@map("media_kind")
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  CLOSED

  @@map("lead_status")
}

enum DealerApplicationStatus {
  NEW
  INFO_REQUESTED
  APPROVED
  REJECTED

  @@map("dealer_application_status")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("publish_status")
}

enum SeoScope {
  GLOBAL
  PAGE
  PRODUCT

  @@map("seo_scope")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS

  @@map("notification_channel")
}

enum BackupKind {
  DAILY
  WEEKLY
  MONTHLY
  MANUAL
  EXPORT

  @@map("backup_kind")
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED

  @@map("backup_status")
}

// =============================================================================
// IDENTITY, ROLES, PERMISSIONS
// =============================================================================

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique @db.VarChar(255)
  passwordHash       String     @map("password_hash") @db.Text
  fullName           String     @map("full_name") @db.VarChar(160)
  phone              String?    @db.VarChar(20)
  status             UserStatus @default(PENDING_ACTIVATION)
  // --- MFA (TOTP). Secret is AES-256-GCM encrypted at the application layer.
  mfaEnabled         Boolean    @default(false) @map("mfa_enabled")
  mfaSecretEncrypted String?    @map("mfa_secret_encrypted") @db.Text
  mfaRecoveryCodes   Json?      @map("mfa_recovery_codes")
  mfaEnrolledAt      DateTime?  @map("mfa_enrolled_at") @db.Timestamptz(6)
  // --- credential hygiene
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp        String?    @map("last_login_ip") @db.VarChar(64)

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById  String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason") @db.Text

  roles              UserRole[]
  dealerLink         DealerUser?
  sessions           Session[]
  passwordResets     PasswordResetToken[]
  notifications      Notification[]
  salesMade          Sale[]               @relation("SaleSoldBy")
  claimsSubmitted    WarrantyClaim[]      @relation("ClaimSubmittedBy")
  claimsReviewed     WarrantyClaim[]      @relation("ClaimReviewedBy")
  dispatchesCreated  Dispatch[]           @relation("DispatchCreatedBy")
  receiptsConfirmed  DealerReceipt[]      @relation("ReceiptConfirmedBy")
  mattressEvents     MattressEvent[]
  claimEvents        ClaimEvent[]
  claimMediaUploads  ClaimMedia[]
  replacementsIssued Replacement[]
  backupsRequested   BackupRun[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  key         RoleKey @unique
  name        String  @db.VarChar(80)
  description String? @db.Text
  isSystem    Boolean @default(true) @map("is_system")
  // Lower rank = more powerful. Prevents privilege escalation by equal peers.
  rank        Int     @default(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(80)
  group       String  @db.VarChar(40)
  description String  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedById String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// =============================================================================
// SESSIONS & CREDENTIAL SECURITY
// =============================================================================

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  // Only the SHA-256 of the session token is stored; the token itself lives in
  // an HttpOnly cookie and is never persisted anywhere server-side.
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  ip             String?   @db.VarChar(64)
  userAgent      String?   @map("user_agent") @db.VarChar(400)
  mfaSatisfied   Boolean   @default(false) @map("mfa_satisfied")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  absoluteExpiry DateTime  @map("absolute_expiry") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason  String?   @map("revoked_reason") @db.VarChar(120)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([absoluteExpiry])
  @@map("sessions")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  // Rotation chain. A second use of an already-rotated token is treated as
  // theft and revokes the whole session family.
  replacedById String?   @unique @map("replaced_by") @db.Uuid

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model FailedLoginAttempt {
  id          BigInt   @id @default(autoincrement())
  email       String   @db.VarChar(255)
  ipHash      String   @map("ip_hash") @db.Char(64)
  userAgent   String?  @map("user_agent") @db.VarChar(400)
  reason      String   @db.VarChar(60)
  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz(6)

  @@index([email, attemptedAt])
  @@index([ipHash, attemptedAt])
  @@map("failed_login_attempts")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdIp String?   @map("created_ip") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// =============================================================================
// DEALER NETWORK
// =============================================================================

model Dealer {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique @db.VarChar(20)
  businessName String       @map("business_name") @db.VarChar(180)
  ownerName    String       @map("owner_name") @db.VarChar(160)
  email        String?      @db.VarChar(255)
  phone        String       @db.VarChar(20)
  gstNumber    String?      @map("gst_number") @db.VarChar(20)
  addressLine1 String       @map("address_line1") @db.VarChar(200)
  addressLine2 String?      @map("address_line2") @db.VarChar(200)
  city         String       @db.VarChar(80)
  state        String       @db.VarChar(80)
  pincode      String       @db.VarChar(10)
  latitude     Decimal?     @db.Decimal(9, 6)
  longitude    Decimal?     @db.Decimal(9, 6)
  status       DealerStatus @default(PENDING)
  // Show this dealer on the public "Find a Dealer" map/list.
  publicListed Boolean      @default(false) @map("public_listed")
  isShowroom   Boolean      @default(true) @map("is_showroom")
  onboardedAt  DateTime?    @map("onboarded_at") @db.Timestamptz(6)
  notes        String?      @db.Text

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById  String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason") @db.Text

  users         DealerUser[]
  mattresses    Mattress[]
  dispatches    Dispatch[]
  receipts      DealerReceipt[]
  customers     Customer[]
  sales         Sale[]
  warranties    Warranty[]
  claims        WarrantyClaim[]
  notifications Notification[]
  application   DealerApplication?

  @@index([status])
  @@index([state, city])
  @@index([publicListed, status])
  @@map("dealers")
}

model DealerUser {
  userId    String   @id @map("user_id") @db.Uuid
  dealerId  String   @map("dealer_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Restrict)

  @@index([dealerId])
  @@map("dealer_users")
}

model DealerApplication {
  id                      String                  @id @default(uuid()) @db.Uuid
  businessName            String                  @map("business_name") @db.VarChar(180)
  ownerName               String                  @map("owner_name") @db.VarChar(160)
  mobile                  String                  @db.VarChar(20)
  email                   String                  @db.VarChar(255)
  city                    String                  @db.VarChar(80)
  state                   String                  @db.VarChar(80)
  address                 String                  @db.VarChar(400)
  gstNumber               String?                 @map("gst_number") @db.VarChar(20)
  hasExistingBusiness     Boolean                 @default(false) @map("has_existing_business")
  existingBusinessDetails String?                 @map("existing_business_details") @db.Text
  message                 String?                 @db.Text
  status                  DealerApplicationStatus @default(NEW)
  reviewNotes             String?                 @map("review_notes") @db.Text
  reviewedById            String?                 @map("reviewed_by") @db.Uuid
  reviewedAt              DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  createdDealerId         String?                 @unique @map("created_dealer_id") @db.Uuid
  // Abuse controls — raw IPs are not retained, only a keyed hash.
  ipHash                  String?                 @map("ip_hash") @db.Char(64)
  userAgent               String?                 @map("user_agent") @db.VarChar(400)
  spamScore               Int                     @default(0) @map("spam_score")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdDealer Dealer? @relation(fields: [createdDealerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("dealer_applications")
}

// =============================================================================
// MANUFACTURING & CATALOGUE
// =============================================================================

model Warehouse {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique @db.VarChar(20)
  name      String  @db.VarChar(160)
  address   String  @db.VarChar(300)
  city      String  @db.VarChar(80)
  state     String  @db.VarChar(80)
  pincode   String  @db.VarChar(10)
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  batches    ManufacturingBatch[]
  dispatches Dispatch[]
  mattresses Mattress[]

  @@map("warehouses")
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  slug             String        @unique @db.VarChar(120)
  name             String        @db.VarChar(160)
  skuPrefix        String        @unique @map("sku_prefix") @db.VarChar(12)
  category         String        @db.VarChar(60)
  tagline          String?       @db.VarChar(200)
  shortDescription String        @map("short_description") @db.VarChar(400)
  description      String        @db.Text
  comfortLevel     String        @map("comfort_level") @db.VarChar(40)
  firmnessScore    Int           @map("firmness_score")
  materials        Json          @default("[]")
  features         Json          @default("[]")
  specifications   Json          @default("{}")
  careInstructions String?       @map("care_instructions") @db.Text
  warrantyYears    Int           @map("warranty_years")
  trialNights      Int?          @map("trial_nights")
  status           PublishStatus @default(DRAFT)
  isFeatured       Boolean       @default(false) @map("is_featured")
  sortOrder        Int           @default(100) @map("sort_order")
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz(6)

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById  String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason") @db.Text

  variants       ProductVariant[]
  websiteProduct WebsiteProduct?
  faqs           Faq[]

  @@index([status, isFeatured])
  @@index([category])
  @@map("products")
}

model ProductVariant {
  id         String        @id @default(uuid()) @db.Uuid
  productId  String        @map("product_id") @db.Uuid
  sku        String        @unique @db.VarChar(40)
  sizeLabel  String        @map("size_label") @db.VarChar(60)
  widthIn    Int           @map("width_in")
  lengthIn   Int           @map("length_in")
  heightIn   Int           @map("height_in")
  mrp        Decimal       @db.Decimal(12, 2)
  weightKg   Decimal?      @map("weight_kg") @db.Decimal(6, 2)
  status     PublishStatus @default(PUBLISHED)
  sortOrder  Int           @default(100) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  mattresses Mattress[]

  @@unique([productId, sizeLabel])
  @@index([productId, status])
  @@map("product_variants")
}

model ManufacturingBatch {
  id               String    @id @default(uuid()) @db.Uuid
  batchCode        String    @unique @map("batch_code") @db.VarChar(30)
  warehouseId      String    @map("warehouse_id") @db.Uuid
  manufacturedOn   DateTime  @map("manufactured_on") @db.Date
  plannedQuantity  Int       @map("planned_quantity")
  producedQuantity Int       @default(0) @map("produced_quantity")
  lineSupervisor   String?   @map("line_supervisor") @db.VarChar(120)
  qualityCheckedBy String?   @map("quality_checked_by") @db.VarChar(120)
  notes            String?   @db.Text

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid

  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  mattresses Mattress[]

  @@index([manufacturedOn])
  @@map("manufacturing_batches")
}

// =============================================================================
// MATTRESS DIGITAL PASSPORT
// =============================================================================

model Mattress {
  id     String @id @default(uuid()) @db.Uuid
  // Human-readable identity printed on the label, e.g. CLF26000001.
  serialNumber String @unique @map("serial_number") @db.VarChar(20)
  // Opaque, unguessable token encoded in the QR. Public verification by QR uses
  // this instead of the serial so the catalogue cannot be enumerated.
  qrToken      String @unique @map("qr_token") @db.VarChar(43)

  productVariantId String         @map("product_variant_id") @db.Uuid
  batchId          String         @map("batch_id") @db.Uuid
  currentStatus    MattressStatus @default(MANUFACTURED) @map("current_status")

  // Location / custody. `current_dealer_id` is the column every dealer-scoped
  // Row Level Security policy keys on.
  currentDealerId    String? @map("current_dealer_id") @db.Uuid
  currentWarehouseId String? @map("current_warehouse_id") @db.Uuid

  manufacturedAt DateTime  @map("manufactured_at") @db.Timestamptz(6)
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz(6)
  receivedAt     DateTime? @map("received_at") @db.Timestamptz(6)
  soldAt         DateTime? @map("sold_at") @db.Timestamptz(6)

  // Replacement linkage: original -> claim -> replacement.
  isReplacement         Boolean @default(false) @map("is_replacement")
  replacementForClaimId String? @unique @map("replacement_for_claim_id") @db.Uuid

  gradeNote String? @map("grade_note") @db.VarChar(200)

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById  String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason") @db.Text

  productVariant ProductVariant      @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  batch          ManufacturingBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  currentDealer  Dealer?             @relation(fields: [currentDealerId], references: [id], onDelete: Restrict)
  warehouse      Warehouse?          @relation(fields: [currentWarehouseId], references: [id], onDelete: Restrict)

  events            MattressEvent[]
  dispatchItems     DispatchItem[]
  receiptItems      DealerReceiptItem[]
  sale              Sale?
  warranty          Warranty?
  claims            WarrantyClaim[]
  replacementOf     Replacement?        @relation("ReplacementOriginal")
  replacementIssued Replacement?        @relation("ReplacementNew")

  @@index([currentDealerId, currentStatus])
  @@index([currentStatus])
  @@index([batchId])
  @@index([productVariantId])
  @@index([manufacturedAt])
  @@map("mattresses")
}

model MattressEvent {
  id          BigInt          @id @default(autoincrement())
  mattressId  String          @map("mattress_id") @db.Uuid
  eventType   String          @map("event_type") @db.VarChar(40)
  fromStatus  MattressStatus? @map("from_status")
  toStatus    MattressStatus? @map("to_status")
  actorUserId String?         @map("actor_user_id") @db.Uuid
  dealerId    String?         @map("dealer_id") @db.Uuid
  payload     Json?
  occurredAt  DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)

  mattress Mattress @relation(fields: [mattressId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([mattressId, occurredAt])
  @@index([eventType])
  @@map("mattress_events")
}

// =============================================================================
// DISPATCH & DEALER RECEIPT
// =============================================================================

model Dispatch {
  id            String         @id @default(uuid()) @db.Uuid
  dispatchCode  String         @unique @map("dispatch_code") @db.VarChar(30)
  warehouseId   String         @map("warehouse_id") @db.Uuid
  dealerId      String         @map("dealer_id") @db.Uuid
  status        DispatchStatus @default(DRAFT)
  dispatchedAt  DateTime?      @map("dispatched_at") @db.Timestamptz(6)
  expectedAt    DateTime?      @map("expected_at") @db.Timestamptz(6)
  transporter   String?        @db.VarChar(120)
  lrNumber      String?        @map("lr_number") @db.VarChar(60)
  vehicleNumber String?        @map("vehicle_number") @db.VarChar(30)
  remarks       String?        @db.Text

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById  String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason") @db.Text

  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  dealer       Dealer          @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  createdBy    User?           @relation("DispatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items        DispatchItem[]
  receipts     DealerReceipt[]
  replacements Replacement[]

  @@index([dealerId, status])
  @@index([status, dispatchedAt])
  @@map("dispatches")
}

model DispatchItem {
  id         String   @id @default(uuid()) @db.Uuid
  dispatchId String   @map("dispatch_id") @db.Uuid
  mattressId String   @map("mattress_id") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  mattress Mattress @relation(fields: [mattressId], references: [id], onDelete: Restrict)

  @@unique([dispatchId, mattressId])
  @@index([mattressId])
  @@map("dispatch_items")
}

model DealerReceipt {
  id               String   @id @default(uuid()) @db.Uuid
  dispatchId       String   @map("dispatch_id") @db.Uuid
  dealerId         String   @map("dealer_id") @db.Uuid
  receivedByUserId String   @map("received_by_user_id") @db.Uuid
  receivedAt       DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  remarks          String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dispatch   Dispatch            @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  dealer     Dealer              @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  receivedBy User                @relation("ReceiptConfirmedBy", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  items      DealerReceiptItem[]

  @@index([dealerId, receivedAt])
  @@index([dispatchId])
  @@map("dealer_receipts")
}

model DealerReceiptItem {
  id         String           @id @default(uuid()) @db.Uuid
  receiptId  String           @map("receipt_id") @db.Uuid
  mattressId String           @map("mattress_id") @db.Uuid
  condition  ReceiptCondition @default(OK)
  remarks    String?          @db.VarChar(300)

  receipt  DealerReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  mattress Mattress      @relation(fields: [mattressId], references: [id], onDelete: Restrict)

  @@unique([receiptId, mattressId])
  @@index([mattressId])
  @@map("dealer_receipt_items")
}

// =============================================================================
// CUSTOMERS, SALES, WARRANTY
// =============================================================================

model Customer {
  id       String @id @default(uuid()) @db.Uuid
  // Customers belong to the dealer that transacted with them — this is the RLS key.
  dealerId String @map("dealer_id") @db.Uuid

  fullName String  @map("full_name") @db.VarChar(160)
  // Contact details are AES-256-GCM encrypted at rest by the application.
  phoneEncrypted String  @map("phone_encrypted") @db.Text
  // Keyed HMAC of the normalised phone: allows dedupe and fraud pattern checks
  // without storing a searchable plaintext phone book.
  phoneHash      String  @map("phone_hash") @db.Char(64)
  emailEncrypted String? @map("email_encrypted") @db.Text
  emailHash      String? @map("email_hash") @db.Char(64)
  addressLine    String? @map("address_line") @db.VarChar(300)
  addressHash    String? @map("address_hash") @db.Char(64)
  city           String? @db.VarChar(80)
  state          String? @db.VarChar(80)
  pincode        String? @db.VarChar(10)

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById  String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason") @db.Text

  dealer     Dealer          @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  sales      Sale[]
  warranties Warranty[]
  claims     WarrantyClaim[]

  @@unique([dealerId, phoneHash])
  @@index([dealerId])
  @@index([phoneHash])
  @@map("customers")
}

model Sale {
  id            String   @id @default(uuid()) @db.Uuid
  dealerId      String   @map("dealer_id") @db.Uuid
  mattressId    String   @unique @map("mattress_id") @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  invoiceNumber String   @map("invoice_number") @db.VarChar(60)
  soldAt        DateTime @map("sold_at") @db.Timestamptz(6)
  salePrice     Decimal  @map("sale_price") @db.Decimal(12, 2)
  paymentMode   String   @map("payment_mode") @db.VarChar(30)
  soldByUserId  String   @map("sold_by_user_id") @db.Uuid
  remarks       String?  @db.Text

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById  String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason") @db.Text

  dealer   Dealer    @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  mattress Mattress  @relation(fields: [mattressId], references: [id], onDelete: Restrict)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  soldBy   User      @relation("SaleSoldBy", fields: [soldByUserId], references: [id], onDelete: Restrict)
  warranty Warranty?

  @@unique([dealerId, invoiceNumber])
  @@index([dealerId, soldAt])
  @@index([customerId])
  @@map("sales")
}

model Warranty {
  id           String         @id @default(uuid()) @db.Uuid
  mattressId   String         @unique @map("mattress_id") @db.Uuid
  saleId       String         @unique @map("sale_id") @db.Uuid
  dealerId     String         @map("dealer_id") @db.Uuid
  customerId   String         @map("customer_id") @db.Uuid
  startDate    DateTime       @map("start_date") @db.Date
  endDate      DateTime       @map("end_date") @db.Date
  years        Int
  status       WarrantyStatus @default(ACTIVE)
  termsVersion String         @map("terms_version") @db.VarChar(20)
  voidReason   String?        @map("void_reason") @db.Text

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById  String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason") @db.Text

  mattress Mattress        @relation(fields: [mattressId], references: [id], onDelete: Restrict)
  sale     Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  dealer   Dealer          @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  claims   WarrantyClaim[]

  @@index([dealerId, status])
  @@index([endDate])
  @@map("warranties")
}

// =============================================================================
// WARRANTY CLAIMS
// =============================================================================

model WarrantyClaim {
  id            String             @id @default(uuid()) @db.Uuid
  claimNumber   String             @unique @map("claim_number") @db.VarChar(30)
  mattressId    String             @map("mattress_id") @db.Uuid
  warrantyId    String             @map("warranty_id") @db.Uuid
  dealerId      String             @map("dealer_id") @db.Uuid
  customerId    String             @map("customer_id") @db.Uuid
  issueCategory ClaimIssueCategory @map("issue_category")
  reportedIssue String             @map("reported_issue") @db.VarChar(200)
  description   String             @db.Text
  status        ClaimStatus        @default(SUBMITTED)

  // Fraud indicators. These are *review aids* for a human decision-maker —
  // never an automatic rejection.
  riskLevel   RiskLevel @default(LOW) @map("risk_level")
  riskScore   Int       @default(0) @map("risk_score")
  riskSignals Json      @default("[]") @map("risk_signals")
  riskComputedAt DateTime? @map("risk_computed_at") @db.Timestamptz(6)

  submittedByUserId String    @map("submitted_by_user_id") @db.Uuid
  submittedAt       DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedByUserId  String?   @map("reviewed_by_user_id") @db.Uuid
  decisionAt        DateTime? @map("decision_at") @db.Timestamptz(6)
  decisionReason    String?   @map("decision_reason") @db.Text
  resolution        String?   @db.Text
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById  String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason") @db.Text

  mattress    Mattress     @relation(fields: [mattressId], references: [id], onDelete: Restrict)
  warranty    Warranty     @relation(fields: [warrantyId], references: [id], onDelete: Restrict)
  dealer      Dealer       @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  submittedBy User         @relation("ClaimSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy  User?        @relation("ClaimReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  media       ClaimMedia[]
  events      ClaimEvent[]
  replacement Replacement?

  @@index([dealerId, status])
  @@index([status, submittedAt])
  @@index([mattressId])
  @@index([riskLevel])
  @@map("warranty_claims")
}

model ClaimMedia {
  id         String    @id @default(uuid()) @db.Uuid
  claimId    String    @map("claim_id") @db.Uuid
  dealerId   String    @map("dealer_id") @db.Uuid
  kind       MediaKind @default(CLAIM_PHOTO)
  // Storage key inside the PRIVATE bucket. Never a public URL.
  storageKey String    @unique @map("storage_key") @db.VarChar(300)
  mimeType   String    @map("mime_type") @db.VarChar(80)
  byteSize   Int       @map("byte_size")
  width      Int?
  height     Int?
  // SHA-256 of the file bytes — powers duplicate-photo fraud detection.
  sha256     String    @db.Char(64)
  caption    String?   @db.VarChar(200)

  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claim      WarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([claimId])
  @@index([sha256])
  @@map("claim_media")
}

model ClaimEvent {
  id          BigInt       @id @default(autoincrement())
  claimId     String       @map("claim_id") @db.Uuid
  eventType   String       @map("event_type") @db.VarChar(40)
  fromStatus  ClaimStatus? @map("from_status")
  toStatus    ClaimStatus? @map("to_status")
  actorUserId String?      @map("actor_user_id") @db.Uuid
  note        String?      @db.Text
  // Notes visible to the dealer vs internal-only review notes.
  isInternal  Boolean      @default(false) @map("is_internal")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  claim WarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actor User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([claimId, createdAt])
  @@map("claim_events")
}

model Replacement {
  id                    String    @id @default(uuid()) @db.Uuid
  claimId               String    @unique @map("claim_id") @db.Uuid
  originalMattressId    String    @unique @map("original_mattress_id") @db.Uuid
  replacementMattressId String    @unique @map("replacement_mattress_id") @db.Uuid
  dealerId              String    @map("dealer_id") @db.Uuid
  approvedByUserId      String    @map("approved_by_user_id") @db.Uuid
  issuedAt              DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  dispatchId            String?   @map("dispatch_id") @db.Uuid
  remarks               String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claim               WarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  originalMattress    Mattress      @relation("ReplacementOriginal", fields: [originalMattressId], references: [id], onDelete: Restrict)
  replacementMattress Mattress      @relation("ReplacementNew", fields: [replacementMattressId], references: [id], onDelete: Restrict)
  approvedBy          User          @relation(fields: [approvedByUserId], references: [id], onDelete: Restrict)
  dispatch            Dispatch?     @relation(fields: [dispatchId], references: [id], onDelete: SetNull)

  @@index([dealerId])
  @@map("replacements")
}

