model BackupRun {
  id            String       @id @default(uuid()) @db.Uuid
  kind          BackupKind
  status        BackupStatus @default(RUNNING)
  startedAt     DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime?    @map("finished_at") @db.Timestamptz(6)
  artifactPath  String?      @map("artifact_path") @db.VarChar(400)
  byteSize      BigInt?      @map("byte_size")
  checksum      String?      @db.Char(64)
  encrypted     Boolean      @default(true)
  offsiteCopied Boolean      @default(false) @map("offsite_copied")
  requestedById String?      @map("requested_by") @db.Uuid
  error         String?      @db.Text

  requestedBy User? @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([kind, startedAt])
  @@map("backup_runs")
}
