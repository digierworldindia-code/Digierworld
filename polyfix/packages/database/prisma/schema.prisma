model Notification {
  id       String              @id @default(uuid()) @db.Uuid
  userId   String?             @map("user_id") @db.Uuid
  dealerId String?             @map("dealer_id") @db.Uuid
  channel  NotificationChannel @default(IN_APP)
  type     String              @db.VarChar(60)
  title    String              @db.VarChar(200)
  body     String              @db.Text
  entity   String?             @db.VarChar(60)
  entityId String?             @map("entity_id") @db.VarChar(64)
  readAt   DateTime?           @map("read_at") @db.Timestamptz(6)
  sentAt   DateTime?           @map("sent_at") @db.Timestamptz(6)
  error    String?             @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealer Dealer? @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([dealerId])
  @@map("notifications")
}

// =============================================================================
// AUDIT & CHANGE HISTORY
// =============================================================================

/// Append-only. The application database role is granted INSERT and SELECT
/// only; UPDATE/DELETE are additionally blocked by a database trigger
/// (see migration 20260101000100_security_hardening).
/// `prev_hash`/`row_hash` form a tamper-evident chain: altering any historical
/// row out-of-band breaks verification.
model AuditLog {
  id            BigInt   @id @default(autoincrement())
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  userId        String?  @map("user_id") @db.Uuid
  userEmail     String?  @map("user_email") @db.VarChar(255)
  roleKey       String?  @map("role_key") @db.VarChar(40)
  dealerId      String?  @map("dealer_id") @db.Uuid
  action        String   @db.VarChar(60)
  entity        String   @db.VarChar(60)
  entityId      String?  @map("entity_id") @db.VarChar(64)
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(400)
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  reason        String?  @db.Text
  requestId     String?  @map("request_id") @db.VarChar(64)
  // prev_hash / row_hash are written by a BEFORE INSERT trigger in the
  // database, not by the application, so application code cannot forge a
  // chain entry. See migration 0002_security_hardening.
  prevHash      String?  @map("prev_hash") @db.Char(64)
  rowHash       String   @default("") @map("row_hash") @db.Char(64)

  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@index([entity, entityId])
  @@index([action])
  @@map("audit_logs")
}

/// Full before/after snapshots for entities where silent manipulation would be
/// damaging (customers, sales, warranties, claims, products).
model RecordVersion {
  id         BigInt   @id @default(autoincrement())
  entity     String   @db.VarChar(60)
  entityId   String   @map("entity_id") @db.VarChar(64)
  version    Int
  data       Json
  changedById String? @map("changed_by") @db.Uuid
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  reason     String?  @db.Text

  @@unique([entity, entityId, version])
  @@index([entity, entityId])
  @@map("record_versions")
}

