{
  "name": "@polyfix/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./context": "./src/context.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "studio": "prisma studio",
    "reset": "prisma migrate reset --force",
    "seed": "node --env-file=../../.env --import tsx seed/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "node --env-file=../../.env --import tsx seed/index.ts"
  },
  "dependencies": {
    "@polyfix/auth": "workspace:*",
    "@polyfix/brand": "workspace:*",
    "@polyfix/config": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "@types/node": "22.18.8"
  }
}
