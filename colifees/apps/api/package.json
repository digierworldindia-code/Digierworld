    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "pino": "9.6.0",
    "qrcode": "1.5.4",
    "zod": "3.25.76",
    "fastify-plugin": "5.0.1",
    "tsx": "4.23.15"
