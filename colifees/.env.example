# =============================================================================
# COLIFEES PLATFORM — ENVIRONMENT TEMPLATE
# -----------------------------------------------------------------------------
# Copy to `.env` for local development:   cp .env.example .env
# NEVER commit `.env`. NEVER put real production secrets in this file.
# Production secrets belong in your secret manager (AWS Secrets Manager,
# GCP Secret Manager, Azure Key Vault, Docker/Kubernetes secrets, or the
# host's encrypted environment store) and are injected at runtime.
# Generate every secret below with:  openssl rand -base64 48
# =============================================================================

# -----------------------------------------------------------------------------
# RUNTIME
# -----------------------------------------------------------------------------
NODE_ENV=development
# development | staging | production  — drives cookie flags, CSP, error verbosity
APP_ENV=development
LOG_LEVEL=debug
# Comma separated. Used for CORS allow-list and absolute URL generation.
PUBLIC_WEB_ORIGIN=http://localhost:3000
PRIVATE_APP_ORIGIN=http://localhost:3001
API_PUBLIC_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# DATABASE — application user (LEAST PRIVILEGE, never the superuser)
# -----------------------------------------------------------------------------
# The application connects with `colifees_app`: CRUD on business tables,
# INSERT-only on audit_logs, no DDL, no BYPASSRLS. See scripts/sql/01_roles.sql.
# In production append ?sslmode=verify-full&sslrootcert=/etc/ssl/certs/pg-ca.crt
DATABASE_URL=postgresql://colifees_app:CHANGE_ME@127.0.0.1:5432/colifees?schema=public&connection_limit=10&pool_timeout=20

# Migration/DDL user (`colifees_owner`). Used ONLY by `prisma migrate` and
# backup tooling — never exported into the running API process.
DIRECT_DATABASE_URL=postgresql://colifees_owner:CHANGE_ME@127.0.0.1:5432/colifees?schema=public

# Shadow database, used ONLY by `prisma migrate dev` when authoring a new
# migration on a developer machine. Create it once as a superuser:
#   createdb -O colifees_owner colifees_shadow
# Production never needs this: `prisma migrate deploy` applies checked-in SQL.
SHADOW_DATABASE_URL=postgresql://colifees_owner:CHANGE_ME@127.0.0.1:5432/colifees_shadow?schema=public

# Optional read-only reporting user (`colifees_readonly`) for BI / analysts.
REPORTING_DATABASE_URL=postgresql://colifees_readonly:CHANGE_ME@127.0.0.1:5432/colifees?schema=public

# -----------------------------------------------------------------------------
# AUTH & CRYPTO  (min 32 chars each; rotate on any suspected exposure)
# -----------------------------------------------------------------------------
AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# Separate key so a leaked access-token key cannot forge QR/media signatures.
SIGNING_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# AES-256-GCM key (base64, exactly 32 bytes decoded) for column encryption of
# TOTP secrets and customer contact data.
ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_IDLE_TIMEOUT_SECONDS=3600
# Cookie domain shared by app.colifees.com — leave blank for localhost.
COOKIE_DOMAIN=
# Brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Require MFA for these role keys (comma separated)
MFA_REQUIRED_ROLES=SUPER_ADMIN,ADMIN,WARRANTY_MANAGER

# -----------------------------------------------------------------------------
# OBJECT STORAGE — S3-compatible (AWS S3, Cloudflare R2, MinIO, DO Spaces)
# Private bucket. No public read. Claim media is served via short-lived
# signed URLs issued by the API after an authorization check.
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
# local | s3
STORAGE_LOCAL_PATH=./storage
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=colifees-private-media
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_FORCE_PATH_STYLE=false
MEDIA_SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=8388608
MAX_UPLOADS_PER_CLAIM=8

# -----------------------------------------------------------------------------
# EMAIL (transactional: password reset, claim updates, dealer onboarding)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM="COLIFEES <no-reply@colifees.com>"
MAIL_SUPPORT_TO=support@colifees.com

# -----------------------------------------------------------------------------
# WHATSAPP / SMS (optional notification channels)
# -----------------------------------------------------------------------------
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_KEY=
SMS_PROVIDER_URL=
SMS_API_KEY=

# -----------------------------------------------------------------------------
# PUBLIC WEBSITE (apps/web) — safe to expose, contains no secrets
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://colifees.com
NEXT_PUBLIC_SITE_NAME=COLIFEES
NEXT_PUBLIC_APP_URL=https://app.colifees.com
# Leave blank to disable analytics entirely (no script is emitted).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
# Server-only: the public site renders on the server and calls the API over the
# private network. This value is never shipped to the browser.
INTERNAL_API_URL=http://127.0.0.1:4000
# Shared secret proving a request came from a trusted front-end, not the internet.
INTERNAL_API_TOKEN=CHANGE_ME_generate_with_openssl_rand_base64_48

# -----------------------------------------------------------------------------
# PRIVATE CONSOLE (apps/app) — admin + dealer portal
# -----------------------------------------------------------------------------
APP_INTERNAL_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_CONSOLE_NAME="COLIFEES Control"

# -----------------------------------------------------------------------------
# BACKUPS
# -----------------------------------------------------------------------------
BACKUP_DIR=./backups
# age/gpg recipient or passphrase file used to encrypt dumps at rest.
BACKUP_ENCRYPTION_PASSPHRASE_FILE=/etc/colifees/backup.pass
BACKUP_S3_BUCKET=colifees-backups
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=12

# -----------------------------------------------------------------------------
# RATE LIMITING / ABUSE
# -----------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_PUBLIC_FORM_PER_HOUR=5
RATE_LIMIT_VERIFY_PER_MINUTE=20
# Trust X-Forwarded-For only when running behind your own proxy/CDN.
TRUST_PROXY=false
