#--------------------------------------------------------------------
# BearingCave environment configuration (copy to .env and edit)
# NEVER commit the real .env file.
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

# MySQL 8+
database.default.hostname = 127.0.0.1
database.default.database = bearingcave
database.default.username = bc
database.default.password = change_me
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Separate database used ONLY by PHPUnit (it is wiped on every run)
database.tests.hostname = 127.0.0.1
database.tests.database = bearingcave_test
database.tests.username = bc
database.tests.password = change_me
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.port = 3306
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci

# Generate with:  php spark key:generate
encryption.key =

# Email delivery (SMTP). Leave protocol=mail-disabled to keep emails queued only.
email.fromEmail = 'no-reply@bearingcave.com'
email.fromName  = 'BearingCave'
email.protocol  = 'smtp'
email.SMTPHost  = ''
email.SMTPUser  = ''
email.SMTPPass  = ''
email.SMTPPort  = 587
email.SMTPCrypto = 'tls'

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
logger.threshold = 4
