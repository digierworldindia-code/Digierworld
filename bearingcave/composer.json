{
    "name": "bearingcave/bearingcave",
    "description": "BearingCave: global B2B automotive surplus inventory marketplace (CodeIgniter 4, MySQL 8, Bootstrap 5.3)",
    "license": "proprietary",
    "type": "project",
    "homepage": "https://www.bearingcave.com",
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "codeigniter4/framework": "^4.7",
        "codeigniter4/shield": "^1.4",
        "phpoffice/phpspreadsheet": "^5.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
