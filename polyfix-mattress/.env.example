#--------------------------------------------------------------------
# POLYFIX MATTRESS — ENVIRONMENT TEMPLATE
#--------------------------------------------------------------------
# Copy to `.env` and fill in every CHANGE_ME:   cp .env.example .env
#
# NEVER commit `.env`. NEVER put production secrets in this file.
# In production, prefer the host's secret store or environment variables;
# CodeIgniter reads real environment variables before .env.
#
# Generate secrets with:
#   openssl rand -base64 48      (APP_KEY_*, signing secret)
#   openssl rand -base64 32      (ENCRYPTION_KEY — must decode to 32 bytes)
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# development | testing | production
# production hides all errors and stack traces from visitors.
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APPLICATION
#--------------------------------------------------------------------
# Public website origin, with trailing slash. Used for canonical URLs, the
# sitemap, QR codes and emails. QR labels already printed in the field encode
# {this}/warranty/verify?q=<token> — keep it stable.
app.baseURL = 'https://polyfixmattress.com/'
app.forceGlobalSecureRequests = true
# Behind a reverse proxy/CDN you control, list its address(es) so the real
# client IP is used for rate limiting. Leave empty otherwise.
# app.proxyIPs = '{"10.0.0.0/8":"X-Forwarded-For"}'

#--------------------------------------------------------------------
# DATABASE — MySQL 8
#--------------------------------------------------------------------
# The application user: SELECT/INSERT/UPDATE/DELETE only. Never root.
# See docs/database.md and database/sql/privileges.sql.
database.default.hostname = 127.0.0.1
database.default.database = polyfix_mattress
database.default.username = polyfix_app
database.default.password = CHANGE_ME
database.default.DBDriver = App\Database\MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_0900_ai_ci
# Encrypt the connection when the database is on another host:
# database.default.encrypt.ssl_verify = true
# database.default.encrypt.ssl_ca = /etc/ssl/certs/mysql-ca.pem

# Test database (used by `composer test`). Must be a separate database.
database.tests.hostname = 127.0.0.1
database.tests.database = polyfix_mattress_test
database.tests.username = polyfix_test
database.tests.password = CHANGE_ME
database.tests.DBDriver = App\Database\MySQLi
database.tests.port = 3306
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_0900_ai_ci

#--------------------------------------------------------------------
# SECRETS — at least 32 characters each, all different
#--------------------------------------------------------------------
# AES-256-GCM key for customer contact data and TOTP secrets.
# base64, exactly 32 bytes when decoded. LOSING IT LOSES THAT DATA.
polyfix.encryptionKey = CHANGE_ME
# HMAC key for blind indexes (duplicate-phone detection) and signed URLs.
# Must be the SAME value the data was written with. Changing it breaks
# duplicate detection for existing customers.
polyfix.signingSecret = CHANGE_ME

# CodeIgniter's own encryption key (sessions/cookies use it if enabled).
encryption.key = CHANGE_ME

#--------------------------------------------------------------------
# SESSIONS & COOKIES
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\DatabaseHandler'
session.savePath = 'ci_sessions'
session.cookieName = 'pfm_session'
session.expiration = 7200
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = true
cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'
# Share one session across polyfixmattress.com subdomains; blank for one host.
cookie.domain = ''

#--------------------------------------------------------------------
# SECURITY POLICY
#--------------------------------------------------------------------
polyfix.loginMaxAttempts = 5
polyfix.loginLockoutSeconds = 900
polyfix.sessionIdleSeconds = 3600
polyfix.sessionAbsoluteSeconds = 43200
# Roles that must enrol in two-factor authentication (comma separated).
polyfix.mfaRequiredRoles = 'SUPER_ADMIN,ADMIN,WARRANTY_MANAGER'

#--------------------------------------------------------------------
# UPLOADS — stored under writable/, never under public/
#--------------------------------------------------------------------
polyfix.uploadPath = WRITEPATH/uploads
polyfix.maxUploadBytes = 8388608
polyfix.maxUploadsPerClaim = 8
polyfix.maxVideoBytes = 26214400

#--------------------------------------------------------------------
# EMAIL (password reset, claim updates)
#--------------------------------------------------------------------
email.protocol = smtp
email.SMTPHost = smtp.example.com
email.SMTPUser = CHANGE_ME
email.SMTPPass = CHANGE_ME
email.SMTPPort = 587
email.SMTPCrypto = tls
email.fromEmail = no-reply@polyfixmattress.com
email.fromName = 'POLYFIX MATTRESS'

#--------------------------------------------------------------------
# PUBLIC WEBSITE
#--------------------------------------------------------------------
# Leave blank to emit no analytics script at all.
polyfix.ga4MeasurementId = ''
polyfix.gscVerification = ''

#--------------------------------------------------------------------
# BACKUPS (scripts/backup.sh)
#--------------------------------------------------------------------
# Read by the backup script, never by the web application.
# BACKUP_DIR=/var/backups/polyfix
# BACKUP_ENCRYPTION_PASSPHRASE_FILE=/etc/polyfix/backup.pass
