{
    "name": "polyfix/mattress-platform",
    "description": "POLYFIX MATTRESS — website, staff console and dealer portal on CodeIgniter 4",
    "license": "proprietary",
    "type": "project",
    "homepage": "https://polyfixmattress.com",
    "require": {
        "php": "^8.2",
        "chillerlan/php-qrcode": "^5.0",
        "codeigniter4/framework": "^4.7",
        "openspout/openspout": "^4.28",
        "picqer/php-barcode-generator": "^3.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
