# QMS - nginx site (generated by deploy/install.sh from deploy/nginx/qms.conf.template)
# Only public/ is web-accessible. Everything else (app, vendor, storage, .env) lives
# outside the document root and cannot be requested at all.

limit_req_zone $binary_remote_addr zone=qms_login:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Let's Encrypt HTTP-01 challenges, then everything goes to HTTPS.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;          # nginx 1.18-1.24 syntax (Ubuntu 22.04 / 24.04)
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     __SSL_CERT__;
    ssl_certificate_key __SSL_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:QMS_SSL:10m;
    ssl_session_tickets off;

    root __APP_DIR__/public;
    index index.php;
    charset utf-8;

    server_tokens off;
    client_max_body_size 8m;          # gauge certificates (5 MB) and logos (1 MB) + form data
    client_body_timeout 30s;
    autoindex off;

    # The application sends CSP, X-Frame-Options, nosniff, Referrer-Policy and
    # Permissions-Policy itself. HSTS is set here because it belongs to the HTTPS endpoint.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    access_log /var/log/nginx/qms.access.log;
    error_log  /var/log/nginx/qms.error.log warn;

    # Maintenance window during updates and restores: sudo touch /var/lib/qms/maintenance
    set $qms_maintenance 0;
    if (-f /var/lib/qms/maintenance) { set $qms_maintenance 1; }
    if ($uri = /maintenance.html) { set $qms_maintenance 0; }
    if ($qms_maintenance = 1) { return 503; }
    error_page 503 /maintenance.html;
    location = /maintenance.html { try_files $uri =404; add_header Retry-After 120 always; add_header Cache-Control "no-store" always; }

    # Hidden files (.env, .git, .htaccess ...) are never served, even if one ends up in public/.
    location ~ /\. {
        deny all;
        return 404;
    }

    # Versioned static assets (cache-busted with ?v=mtime).
    location ^~ /assets/ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    location = /favicon.ico { access_log off; log_not_found off; try_files $uri =404; }
    location = /robots.txt  { access_log off; try_files $uri =404; }

    # Slow down password guessing before it reaches PHP (the app also throttles and locks accounts).
    location = /login {
        limit_req zone=qms_login burst=10 nodelay;
        limit_req_status 429;
        try_files $uri /index.php$is_args$args;
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    # Only the front controller is executed. Any other *.php request is refused.
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTPS on;
        fastcgi_hide_header Strict-Transport-Security;   # sent once, by nginx (above)
        fastcgi_hide_header X-Powered-By;
        fastcgi_pass unix:/run/php/qms-fpm.sock;
        fastcgi_read_timeout 120s;      # large PDF / CSV exports
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }
    location ~ \.php$ {
        return 404;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;
    gzip_min_length 1024;
}
