# QMS scheduled jobs (generated by deploy/install.sh). Times are server time (UTC).
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Google Sheets outbox: every minute, never two workers at once.
* * * * *  __APP_USER__  flock -n /tmp/qms-sheets.lock php __APP_DIR__/bin/qms.php sheets:sync --quiet >> /var/log/qms/sheets-sync.log 2>&1

# Housekeeping: idempotency keys, expired sessions, PDF temp files, old logs.
15 2 * * *  __APP_USER__  php __APP_DIR__/bin/qms.php maintenance >> /var/log/qms/maintenance.log 2>&1

# Nightly database + uploads backup (keeps 14 days in /var/backups/qms).
30 1 * * *  root  /usr/local/sbin/qms-backup >> /var/log/qms/backup.log 2>&1
