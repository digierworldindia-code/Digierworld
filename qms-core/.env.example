#--------------------------------------------------------------------
# QMS configuration. Copy to .env (same folder as this file, NOT inside
# public/) and fill in. The web setup page and deploy/install.sh write
# this file for you. Never commit .env or share it.
#--------------------------------------------------------------------

# production | development (never "development" on a server: it shows error details)
APP_ENV=production

# Address users open in the browser, with a trailing slash.
APP_URL=https://qms.example.com/

# Redirect http:// to https:// and send HSTS (default: on when APP_URL is https).
# APP_FORCE_HTTPS=true

# MySQL 8.0.16+ (localhost uses the local socket; or set DB_SOCKET=/path/mysqld.sock)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qms
DB_USER=qms_app
DB_PASS=

# Session cookie (defaults: Secure + "__Host-qms_session" on HTTPS).
# COOKIE_SECURE=true
# SESSION_COOKIE=__Host-qms_session

# Behind a load balancer / reverse proxy: its IPs or CIDR ranges, comma-separated.
# Only then are X-Forwarded-For / X-Forwarded-Proto believed.
TRUSTED_PROXIES=

# Google Sheets service-account key: a PATH outside public/ (mode 0400/0440).
# Example (VPS): /etc/qms/secrets/google-sa.json   Example (shared hosting): /home/USER/qms-secrets/google-sa.json
GOOGLE_CREDENTIALS_FILE=

# Automated tests only (vendor/bin/phpunit): a separate database whose name contains "test".
# TEST_DB_HOST=127.0.0.1
# TEST_DB_NAME=qms_tests
# TEST_DB_USER=qms_dev
# TEST_DB_PASS=
