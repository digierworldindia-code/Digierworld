# Environment and secrets: never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*service-account*.json
*credentials*.json
google-sa*.json

# Composer and published front-end libraries (rebuilt by composer install)
/vendor/
/public/assets/vendor/

# CodeIgniter writable folders (keep the folder structure only)
/writable/cache/*
/writable/logs/*
/writable/session/*
/writable/uploads/*
/writable/debugbar/*
/writable/*.json
!/writable/**/index.html
!/writable/**/.htaccess

# Tests, tooling and release packages
/build/
/dist/
.phpunit.cache/
.phpunit.result.cache
/tests/e2e/node_modules/
/tests/e2e/*.png

# Backups and dumps
*.sql.gz
*.sql.zst
*.age
/backups/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
