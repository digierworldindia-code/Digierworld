; QMS - dedicated PHP-FPM pool (generated by deploy/install.sh)
; Runs as the unprivileged system user "qms"; nginx talks to it over a unix socket.
[qms]
user = __APP_USER__
group = __APP_USER__
listen = /run/php/qms-fpm.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = dynamic
pm.max_children = 20
pm.start_servers = 4
pm.min_spare_servers = 2
pm.max_spare_servers = 6
pm.max_requests = 500
request_terminate_timeout = 120s

; Do not leak the server's environment into PHP; the app reads its own .env.
clear_env = yes
catch_workers_output = yes
security.limit_extensions = .php

php_admin_value[error_log] = /var/log/qms/php-fpm.log
php_admin_flag[log_errors] = on
php_admin_flag[display_errors] = off
php_admin_value[open_basedir] = __APP_DIR__/:/etc/qms/secrets/:/tmp/:/usr/share/zoneinfo/:/etc/ssl/certs/:/usr/share/ca-certificates/:/usr/lib/ssl/
php_admin_value[upload_tmp_dir] = __APP_DIR__/writable/uploads/tmp
php_admin_value[upload_max_filesize] = 6M
php_admin_value[post_max_size] = 8M
php_admin_value[max_execution_time] = 120
php_admin_value[memory_limit] = 256M
php_admin_value[disable_functions] = exec,passthru,shell_exec,system,proc_open,popen,pcntl_exec,dl
php_admin_flag[allow_url_include] = off
