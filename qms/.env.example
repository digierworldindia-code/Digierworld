#--------------------------------------------------------------------
# QMS configuration (copy to .env). On a server, deploy/install.sh writes
# this file for you with generated credentials. Never commit .env.
#--------------------------------------------------------------------

# production | development (never "development" on a server)
CI_ENVIRONMENT = production

app.baseURL = 'https://qms.example.com/'
app.forceGlobalSecureRequests = true
# Behind a load balancer / reverse proxy (client IP and HTTPS detection):
# app.proxyIPs.10.0.0.0/8 = X-Forwarded-For

# Runtime account qms_app (DML only). Migrations use qms_migrator (see deploy/install.sh).
database.default.hostname = localhost
database.default.database = qms
database.default.username = qms_app
database.default.password =

# Automated tests (php vendor/bin/phpunit) use a separate database:
# database.tests.hostname = localhost
# database.tests.database = qms_tests
# database.tests.username = qms_dev
# database.tests.password =

# 32 random bytes: php -r "echo 'hex2bin:' . bin2hex(random_bytes(32)), PHP_EOL;"
encryption.key =

cookie.secure = true
cookie.samesite = Lax
session.cookieName = __Host-qms_session

# Google Sheets service-account key: a PATH outside the project (mode 0440).
google.credentialsFile = /etc/qms/secrets/google-sa.json
